# Copy to .env and fill in.
# For a real demo account create testnet keys at:
#   Binance:  https://testnet.binance.vision/
#   Bybit:    https://testnet.bybit.com/
#   OKX:      https://www.okx.com/account/my-api  (demo trading)
#
# Leave empty to use the built-in local paper broker (no keys required).

EXCHANGE=binance
USE_TESTNET=true

BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Local paper trading starting balance (USDT)
PAPER_START_BALANCE=10000

# Webhook receiver for TradingView alerts
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET=change-me
