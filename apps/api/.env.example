DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/compliance?schema=public"
SESSION_SECRET="change-me-min-32-characters-long-secret"
PORT=3000
COOKIE_SECURE=true
STORAGE_DRIVER=local
STORAGE_DIR=.storage
